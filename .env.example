# Dominio público (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.newgraf.es

# Servir vídeos desde /public/media/higgsfield en lugar del CDN de Higgsfield (tras npm run media:fetch)
NEXT_PUBLIC_LOCAL_MEDIA=0

# Destino de las solicitudes del formulario (usa UNA de las dos opciones)
# 1) Webhook (Make, Zapier, n8n, CRM…): recibe multipart/form-data con el archivo adjunto
LEAD_WEBHOOK_URL=
# 2) Email vía Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL="Newgraf Web <web@tudominio.es>"
